# Define the true test-set responses
y_true <- test_set$label
# 1. Fit the Logistic Regression Model: Corrected with 'data' and 'control' for convergence
y <- train_set$label
out.log <- glm(
y ~ .,
data = train_set,
family = binomial,
control = list(maxit = 50)
)
# 2. Predict Probabilities on the Test Set
resp.prob <- predict(out.log, newdata = test_set, type = "response")
# 3. Convert Probabilities to Predicted Classes (using actual levels)
resp.pred <- ifelse(resp.prob > 0.5, "SUCCESS", "FAILURE")
# 4. Convert predictions to a factor
resp.pred <- factor(resp.pred, levels = levels(y_true))
# 5. Calculate the Misclassification Rate (MCR)
misclassification_rate <- mean(resp.pred != y_true)
print(paste("Misclassification Rate:", round(misclassification_rate, 4)))
# 6. Create the Confusion Matrix and save as tab
tab <- table(Predicted = resp.pred, Actual = y_true)
print("Confusion Matrix:")
print(tab)
