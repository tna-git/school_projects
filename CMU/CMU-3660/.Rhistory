alpha <- 0.05
set.seed(42)
sample <- rnorm(100, 10, 2)
f <- function(mu, sample.bar, s, n, q) {
pt((x.bar - mu) / (s / sqrt(n)), n - 1) - q  # "p" in "pt" means cumulative distribution function
# "t" in "pt" means t-distribution
}
uniroot(f, interval = c(-100, 100), sample.bar = mean(x), s = 0.2, n = length(x), q = 1-alpha/2)$root
